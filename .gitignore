.dev.vars
.wrangler/
node_modules/
.DS_Store
__pycache__/
*.pyc

# generated Phase 0 catalog seed (regenerate with build/seed_catalog.py)
seed_releases.sql

# The append-only session log lives at the PROJECT ROOT, outside this repo — never commit a
# copy here. Guards against a stray created by a mis-cd'd `>> log.md` append.
log.md

# E5 (#103): Supabase CLI link state is machine-local (carries the org id); never track it.
supabase/.temp/

# E5 (#103): impeccable plugin cache/state — was only excluded via .git/info/exclude, which
# a fresh clone doesn't have (never actually committed — pass-1 audit verified by git log —
# but one absent-minded `git add -A` away from it until this line).
.impeccable/
_to_delete/

# Build-time deploy marker (#144): generated by build/write-version.mjs during the Pages build
# from VERSION; never committed (so it always matches the deployed commit, and a missing build
# step surfaces as a RED uptime probe rather than a stale committed marker).
public/version.json
